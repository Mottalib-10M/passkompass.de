---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const c1 = `<iframe src="${SITE_URL}/embed/einbuergerungstest/" title="German citizenship test mock exam" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const c2 = `<iframe src="${SITE_URL}/embed/einbuergerung-rechner/" title="Earliest German citizenship application" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the German citizenship test: mock exam and calculator" description="Embed the German citizenship test mock exam and the earliest-application calculator for free with an iframe: copy the code, no cookies, catalogue updates arrive by themselves." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the mock exam and calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For integration course providers, advice centres and associations: copy once, catalogue changes appear by themselves. The embedded tools are in German.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Mock exam</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{c1}</code></pre>
    <h2>Earliest application calculator</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{c2}</code></pre>
    <p>Terms: the source link under the tool stays visible, the tool is not altered and is provided without warranty. What your readers enter stays on their device. Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/einbuergerungstest/" title="German citizenship test mock exam" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
