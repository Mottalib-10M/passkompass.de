---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL, SITE_NAMES } from '../../data/site-config';
import { srcLink } from '../../lib/helpers';
import { HOME } from '../../content/home';
import { KIT as K } from '../../lib/kit';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const path = route('about', lang);
const title = 'Passkompass Publisher and Sources 2026: Who Checks Answers';
const description = 'Passkompass is published by Radif Partners: the official question catalogue with answers we checked and calculators based on the 2026 Nationality Act.';
const s = (k: string, t: string) => srcLink(k, lang, t);
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'About', path }])]} breadcrumbs={[{ label: 'About' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>About {SITE_NAMES[lang]}</h1>
    <p>{AUTHOR_DESC.en}</p>
    <h2>Why this site exists</h2>
    <p>Searching for the German citizenship test mostly turns up two kinds of page. One lists the questions, but without explanation, without a link to your own state, in German only or behind a sign-up. The other explains naturalisation but does not work out when you yourself can apply, and is often still written for the rules before the reform or before the three-year route was abolished.</p>
    <p><strong>{HOME.en.valeur}</strong></p>
    <h2>Who publishes it</h2>
    <p>The site is published by {AUTHOR_NAME}, a company that builds calculators from public data. It is not an authority, not BAMF, not a test centre, not a language school and not a law firm. It sells nothing, refers no one to courses and asks for no name, email or phone number. Pages carry no affiliate links.</p>
    <LegalIdentity lang={lang} />
    <h2>Where the questions and figures come from</h2>
    <p>The {K.P.katalog.fragen} questions come from <Fragment set:html={s('bamf-katalog', 'BAMF’s complete question catalogue')} />, annex 1 to the <Fragment set:html={s('einbtestv', 'Citizenship Test Ordinance')} />. BAMF publishes no answer key, so {AUTHOR_NAME} worked out the answers itself and checked each one twice; the English translations are ours too. Images from the catalogue are described in words. Periods and fees come from the <Fragment set:html={s('stag10', 'Nationality Act')} />, the Residence Act and the ordinances, each with its section. The <a href={route('method', lang)}>method page</a> explains the calculations; the <a href={route('editorial', lang)}>editorial policy</a> explains corrections.</p>
    <h2>What the site does not do</h2>
    <p>It takes no applications, never sees your file and cannot speed anything up. The calculator gives an assessment based on the text of the law, not legal advice and not a promise; your naturalisation authority decides.</p>
    <h2>Write to us</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>, if you spot a wrong answer or an outdated figure.</p>
  </article>
</PageLayout>
